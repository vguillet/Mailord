  "mdse": "2.3",
  "kind": "Design",
  "id": "DESIGN",
  "name": "Destinations virtuelles et matérialisation locale",
  "status": "approved",
  "revision": 1,
  "createdAt": "2026-10-24",
  "updatedAt": "2026-10-24",
  "workItem": "WI-lazy-folders",
  "requirements": [
    "REQ-01",
    "REQ-02",
    "REQ-03"
  ],
  "decisions": [
    "DEC-01"
  ],
  "components": [
    {
      "name": "GestionClients",
      "state": "modified",
      "path": "autosecretaire/engine.py",
      "responsibility": "Réserver les destinations sans mkdir et exposer tous les chemins disponibles."
    },
    {
      "name": "ArchivageLocal",
      "state": "modified",
      "path": "autosecretaire/engine.py",
      "responsibility": "Créer au premier fichier ; retirer uniquement les parents vides sur les branches concernées, sans suivre les liens."
    },
    {
      "name": "InterfaceLocale",
      "state": "modified",
      "path": "autosecretaire/static/app.js",
      "responsibility": "Distinguer les destinations présentes de celles à créer et expliquer le modèle virtuel."
    }
  ],
  "internalInterfaces": [
    {
      "signature": "Engine.client_folders(client, existing=None); Engine.existing_folders(client)",
      "purpose": "Union modèle courant + chemins mémorisés + dossiers réels + 00 - À classer, avec ancêtres implicites. Lecture seule. state ajoute existing_folders sans migration persistante."
    },
    {
      "signature": "Engine.retry_client; Engine.apply_template",
      "purpose": "Création mail et validation du chemin local sans mkdir ; apply_template mémorise une version/addition virtuelle sans écriture documentaire."
    },
    {
      "signature": "Engine._target; Engine._publish; Engine._prune_empty(root, directory)",
      "purpose": "Calcul de collision compatible avec parent absent. Création seulement pendant publication ; rmdir borné, sans récursion de suppression, s’arrête au premier dossier non vide et ne suit pas les liens. Appelé pour la source après déplacement et après échec de publication."
    },
    {
      "signature": "Engine.process; Engine.classify; Engine._recover_moves",
      "purpose": "Supprimer mkdir anticipés. Validation de toutes les sources avant intentions de déplacement ; reprise crée les parents à la publication et nettoie les sources vidées. Les empreintes et intentions continuent de protéger les fichiers."
    }
  ]
}
