    "REQ-05"
  ],
  "decisions": [
    "DEC-01",
    "DEC-02"
  ],
  "components": [
    {
      "name": "InterfaceLocale",
      "state": "modified",
      "path": "autosecretaire/static/app.js",
      "responsibility": "Espace compact avec champs De/À/Reçu/Client puis corps du mail en premier, ouvert par défaut et repliable, puis PDF et pièces jointes, compteurs de classement et impression, cases libellées, recherche dans noms/destinations, modèle repliable et recherchable, annulation par document."
    },
    {
      "name": "Impression",
      "state": "modified",
      "path": "autosecretaire/engine.py",
      "responsibility": "Progression dérivée du dernier essai par document ; distinguer partiel, simulation et soumission. Les reprises utilisent la dernière intention, sans rejouer les anciennes."
    },
    {
      "name": "ArchivageLocal",
      "state": "modified",
      "path": "autosecretaire/engine.py",
      "responsibility": "Mémoriser un seul classement antérieur par document et le restaurer via intention persistée, jeton idempotent, contrôles de contenu et refus des collisions, sans impression."
    }
  ],
  "internalInterfaces": [
    {
      "signature": "Engine.print_progress(message) -> total/submitted/simulated/pending/error/uncertain/preparing/submitting ; state.messages[].print_progress",
      "purpose": "Agrégation courante des derniers travaux ; print_status distingue partial, not_selected, preparing et mixed sans mutation."
    },
    {
      "signature": "POST /api/documents/{id}/undo-filing {token:string}",
      "purpose": "Retour idempotent au chemin et classement antérieurs ; rejet des fichiers modifiés, collisions et jetons obsolètes ; aucune soumission impression."
    },
    {
      "signature": "messageMatches(message, query, clientName) / folderEntries",
      "purpose": "Recherche accents/casse sur mail, noms et destinations ; recherche et expansion du modèle indépendantes des choix persistants."
    }
  ]
}
