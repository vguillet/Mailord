  "crossCuttingConcerns": [
    {
      "concern": "Identité et reprise",
      "approach": "Utiliser un registre durable indépendant du nom de fichier et de l'état lu/non lu. Les mouvements de message ou renommages du client ne valent pas nouvelle demande d'impression."
    },
    {
      "concern": "Nommage",
      "approach": "Format initial proposé : AAAA-MM-JJ - nom de base.ext. Garder le nom original des pièces jointes et utiliser l'objet pour le PDF du mail. Définir la source de date et le fuseau dans les exigences."
    },
    {
      "concern": "Modèles",
      "approach": "Le modèle courant est proposé avec les destinations mémorisées, réelles et leurs parents. Mémoriser une version ne crée aucun dossier. Les choix initiaux persistent et restent protégés même vides. initial_folders définit les présélections ; lecture des anciennes versions avec défauts compatibles sans réécriture. Renommer une branche conserve les présélections dans l’éditeur. Ancien rôle email_folder retiré de l’interface et sans effet sur le classement."
    },
    {
      "concern": "Données locales",
      "approach": "Racine documentaire choisie par l'utilisatrice, fichier de suivi persistant, secrets et données personnelles hors du dépôt de développement. Afficher la provenance et le résultat des étapes."
    },
    {
      "concern": "Intégration réelle",
      "approach": "Valider sur fixtures et copies de messages puis sur l'environnement cible autorisé ; ne pas manipuler directement la base interne d'Apple Mail sans contrat d'intégration démontré."
    },
    {
      "concern": "Impression",
      "approach": "Distinguer préparé, soumis, en attente, échec et résultat incertain ; une soumission ne prouve pas à elle seule que le papier a été imprimé."
    },
    {
      "concern": "Vérification et limites",
      "approach": "239 tests réussis, paquet Mailord, parcours IAB et démarrage supervisé dans le dépôt final ; 13 archives et classements conservés. Intégrations matérielles et acceptation de l’utilisatrice distinctes."
    },
    {
      "concern": "Mises à jour et compatibilité",
      "approach": "Protocole et schéma version 1 déclarés dans update.json ; accès Git de confiance configuré une fois ; rollback uniquement avant activation ; aucune réinitialisation du dépôt utilisateur."
    },
    {
      "concern": "Préférences d’impression",
      "approach": "Réglages persistants print_sides/print_color_mode, défauts du pilote préservés ; instantané par intention, reprise preparing stable, pas de réimpression implicite ni altération des archives."
    },
    {
      "concern": "Séparation des archives",
      "approach": "Message.filing_version=3 ; destination/classification de chaque document conservées à l’adaptation, ancien email_destination retiré sans mouvement. PDF et pièces jointes nouveaux pending ; message.classification agrège tous les documents et intentions. Réparation à l’emplacement enregistré et impressions existantes préservées."
    },
    {
      "concern": "Reprise d’emplacement",
      "approach": "scripts/relocate_runtime.py exige un service arrêté, refuse destination existante et liens ; copie atomique, sauvegarde SQLite, réécriture des champs de chemins internes seulement. Source conservée et fichiers de correspondance inchangés."
    }
  ],
