      "rationale": "Accès aux services Apple Mail et CUPS sans relais Docker."
    },
    {
      "layer": "Interface",
      "technology": "HTML, CSS, JavaScript local et FastAPI",
      "rationale": "Interface en français sans dépendance à un service externe ni compilation frontend."
    },
    {
      "layer": "Messagerie",
      "technology": "Dossiers .eml de démonstration, IMAP TLS stdlib, JXA via osascript",
      "rationale": "Dossiers serveur ou Sur mon Mac via adaptateurs distincts, sans base interne de Mail."
    },
    {
      "layer": "Documents",
      "technology": "ReportLab, pypdf, Pillow",
      "rationale": "PDF texte passif, originaux préservés, validation et conversion locale des formats compatibles."
