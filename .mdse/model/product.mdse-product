  "createdAt": "2026-10-23",
  "updatedAt": "2026-10-24",
  "problem": "La professionnelle classe les communications de ses clients dans des dossiers de messagerie, puis télécharge, renomme, range et imprime manuellement les mails et leurs pièces jointes. Elle doit vérifier ce qui a déjà été enregistré et reproduire une structure de dossiers pour chaque nouveau client.",
  "valueProposition": "Conserver son organisation par client tout en automatisant l'export PDF, le nommage chronologique, le contrôle des documents et l'impression, avec une interface locale qui rend le classement rapide et l'avancement visible.",
  "targetUsers": [
    {
      "persona": "Professionnelle qui gère les communications de ses clients dans Apple Mail sur Mac",
      "needs": [
        "Réduire les manipulations répétitives sans perdre le contrôle des destinations.",
        "Créer des dossiers clients cohérents et les adapter facilement.",
        "Retrouver les documents dans le Finder et savoir précisément ce qui reste à traiter."
      ],
      "painPoints": [
        "Exports manuels répétés et noms de fichiers hétérogènes.",
        "Doute sur les mails déjà archivés ou imprimés.",
        "Création et entretien répétitifs de la même arborescence."
      ]
    }
  ],
  "needs": [
    {
      "id": "NEED-01",
      "statement": "Exécuter la gestion documentaire sur son Mac, au moyen d'un service en arrière-plan et d'une interface web locale, puis laisser son outil habituel synchroniser les fichiers vers le cloud.",
      "persona": "Professionnelle qui gère les communications de ses clients dans Apple Mail sur Mac",
      "priority": "must"
    },
    {
      "id": "NEED-02",
      "statement": "Associer chaque client à un dossier de messagerie et à un dossier documentaire local, et reprendre les clients et dossiers existants sans imposer des tags.",
      "persona": "Professionnelle qui gère les communications de ses clients dans Apple Mail sur Mac",
      "priority": "must"
    },
    {
      "id": "NEED-03",
      "statement": "Créer un client avec son dossier mail et ajuster les présélections du modèle (Correspondances initialement) pour les dossiers locaux à préparer même vides ; les autres branches sont créées au premier document, avec reprise des créations incomplètes.",
      "persona": "Professionnelle qui gère les communications de ses clients dans Apple Mail sur Mac",
      "priority": "must"
    },
    {
      "id": "NEED-04",
      "statement": "Construire et modifier visuellement le modèle de dossiers clients, prévisualiser le résultat et personnaliser les noms et la structure sans écrire du code.",
      "persona": "Professionnelle qui gère les communications de ses clients dans Apple Mail sur Mac",
      "priority": "must"
    },
    {
      "id": "NEED-05",
      "statement": "Repérer les messages non encore exportés dans les dossiers clients, même s'ils sont déjà lus ou ont été déplacés après leur réception, et les placer dans une file de traitement.",
      "persona": "Professionnelle qui gère les communications de ses clients dans Apple Mail sur Mac",
      "priority": "must"
    },
    {
      "id": "NEED-06",
      "statement": "Obtenir automatiquement un PDF lisible de chaque mail avec ses en-têtes utiles, ainsi que ses pièces jointes conservées localement et préparées pour l’impression lorsque leur format le permet. Choisir leur destination de classement, y compris celle du PDF du mail.",
      "persona": "Professionnelle qui gère les communications de ses clients dans Apple Mail sur Mac",
      "priority": "must"
    },
    {
      "id": "NEED-07",
      "statement": "Conserver le nom de base des documents et lui ajouter systématiquement un préfixe année-mois-jour, avec un format personnalisable, un ordre chronologique et aucune perte par collision de noms.",
      "persona": "Professionnelle qui gère les communications de ses clients dans Apple Mail sur Mac",
      "priority": "must"
    },
    {
      "id": "NEED-08",
      "statement": "Vérifier la présence et la validité des PDF attendus, repérer les exports absents ou incomplets et reprendre uniquement les opérations nécessaires grâce à un registre persistant.",
      "persona": "Professionnelle qui gère les communications de ses clients dans Apple Mail sur Mac",
      "priority": "must"
    },
    {
      "id": "NEED-09",
      "statement": "Naviguer par client, consulter mails, PDF, pièces jointes, statuts et emplacements exacts, et repérer immédiatement les documents non classés grâce à un affichage contrasté et explicite.",
      "persona": "Professionnelle qui gère les communications de ses clients dans Apple Mail sur Mac",
      "priority": "must"
    },
    {
